# Postgres (Neon / Supabase)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Public app URL, no trailing slash
APP_URL="https://your-app.vercel.app"

# Random secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
ENCRYPTION_KEY=""          # must be 64 hex characters
CRON_SECRET=""
WEBHOOK_VERIFY_TOKEN=""    # paste the same value in Meta webhook settings (Instagram and Facebook)

# Instagram: Meta app > Instagram use case > API setup with Instagram business login
IG_APP_ID=""
IG_APP_SECRET=""

# Facebook: Meta app > App settings > Basic (the main App ID and App Secret)
FB_APP_ID=""
FB_APP_SECRET=""

META_API_VERSION="v23.0"
NEXT_PUBLIC_SUPPORT_EMAIL="you@example.com"

# Billing: Razorpay (dashboard.razorpay.com → Settings → API Keys / Subscriptions → Plans / Webhooks)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_STARTER=""   # plan_xxx for ₹499/month
RAZORPAY_PLAN_PRO=""       # plan_xxx for ₹1,499/month
RAZORPAY_PLAN_AGENCY=""    # plan_xxx for ₹3,999/month

# Email (resend.com): reconnect alerts, payment alerts, password resets
RESEND_API_KEY=""
EMAIL_FROM="ReplyRelay <hello@yourdomain.in>"
