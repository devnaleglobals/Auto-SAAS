# Postgres (Neon / Supabase)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Public app URL, no trailing slash
APP_URL="https://your-app.vercel.app"

# Random secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
ENCRYPTION_KEY=""          # must be 64 hex characters
CRON_SECRET=""              # at least 16 characters; cron routes refuse to run without it
WEBHOOK_VERIFY_TOKEN=""    # paste the same value in Meta webhook settings (Instagram and Facebook)

# Instagram: Meta app > Instagram use case > API setup with Instagram business login
IG_APP_ID=""
IG_APP_SECRET=""

# Facebook: Meta app > App settings > Basic (the main App ID and App Secret)
FB_APP_ID=""
FB_APP_SECRET=""

META_API_VERSION="v23.0"
NEXT_PUBLIC_SUPPORT_EMAIL="you@example.com"

# Billing: Razorpay. Keys and plan IDs can also be set in Admin → Settings (those override these).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_PLAN_STARTER=""   # plan_xxx for ₹499/month
RAZORPAY_PLAN_PRO=""       # plan_xxx for ₹1,499/month
RAZORPAY_PLAN_AGENCY=""    # plan_xxx for ₹3,999/month

# Email: set the provider in Admin → Settings → Email delivery (Resend, SendGrid, Mailgun, Postmark,
# Brevo, Zoho ZeptoMail or any SMTP). These two are only a fallback if nothing is set there.
RESEND_API_KEY=""
EMAIL_FROM="ReplyRelay <hello@yourdomain.in>"

# Business details shown on the website (must match the GST certificate used for Meta verification)
NEXT_PUBLIC_COMPANY_NAME="Daily Space Company"
NEXT_PUBLIC_COMPANY_LEGAL_NAME="Meena Bai"
NEXT_PUBLIC_COMPANY_ADDRESS="Full address exactly as on the GST certificate"
NEXT_PUBLIC_COMPANY_PHONE="+91 ..."
NEXT_PUBLIC_COMPANY_GSTIN=""

# Legal pages (Privacy, Terms, Contact)
NEXT_PUBLIC_COMPANY_JURISDICTION="Bidar, Karnataka"     # city whose courts are named in the Terms
NEXT_PUBLIC_GRIEVANCE_OFFICER="Meena Bai"               # name of the Grievance Officer (IT Act / DPDP Act)
NEXT_PUBLIC_GRIEVANCE_EMAIL=""                          # defaults to NEXT_PUBLIC_SUPPORT_EMAIL

# Optional: data retention in days (defaults shown; the Privacy Policy updates automatically)
# RETENTION_ACTIVITY_DAYS=365
# RETENTION_LEAD_DAYS=730

# Admin console (/admin/login). Needed once to create the first admin at /admin/setup.
# Random value, at least 16 characters. You can remove it after the first admin exists.
ADMIN_SETUP_TOKEN=""
